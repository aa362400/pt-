enum ResearchCandidateDecisionStatus {
  APPROVED
  REJECTED
}

// A human decision on an agent-proposed candidate. A unique key prevents the
// same candidate from returning to the pending queue after it was rejected.
model ProductResearchCandidateDecision {
  id             String                          @id @default(cuid())
  organizationId String
  reportId       String
  workspaceId    String?
  candidateIndex Int
  status         ResearchCandidateDecisionStatus
  reason         String?
  actorId        String
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  candidateId    String?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       ProductResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  candidate    ProductCandidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reportId, candidateIndex])
  @@unique([organizationId, candidateId])
  @@index([organizationId])
  @@index([reportId])
  @@index([workspaceId])
  @@index([status])
  @@index([candidateId])
  @@map("product_research_candidate_decisions")
}

model ProductResearchRun {
  id                String                    @id @default(cuid())
  organizationId    String
  workspaceId       String?
  workspaceScopeKey String                    @default("ORG")
  automationRunId   String?
  parentRunId       String?
  businessDate      DateTime                  @db.Date
  scheduleTimezone  String                    @default("Asia/Shanghai")
  trigger           ProductResearchRunTrigger
  attempt           Int                       @default(0)
  status            ProductResearchRunStatus  @default(PENDING)
  currentStage      ProductResearchStage?
  partialData       Boolean                   @default(false)
  configSnapshot    Json                      @default("{}")
  configVersion     String
  scoringVersionId  String?
  candidateLimit    Int                       @default(300)
  topLimit          Int                       @default(10)
  startedAt         DateTime?
  finishedAt        DateTime?
  errorSummary      Json?
  createdBy         String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization                Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace                   Workspace?                          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  scoringVersion              ScoringVersion?                     @relation(fields: [scoringVersionId], references: [id], onDelete: SetNull)
  parent                      ProductResearchRun?                 @relation("ProductResearchRunRetry", fields: [parentRunId], references: [id], onDelete: SetNull)
  retries                     ProductResearchRun[]                @relation("ProductResearchRunRetry")
  stages                      ProductResearchStageRun[]
  candidates                  ProductCandidate[]
  signals                     ProductSignal[]
  risks                       ProductRiskRecord[]
  scores                      ProductScore[]
  sourceHealth                ProductResearchSourceHealth[]
  artifacts                   ResearchReportArtifact[]
  supplierQuotes              SupplierQuoteEvidence[]
  supplierImageSearchEvidence SupplierImageSearchEvidence[]
  economicsEvidence           CandidateEconomicsEvidence[]
  economicsEvaluations        CandidateEconomicsEvaluation[]
  economicsEvaluationInputs   CandidateEconomicsEvaluationInput[]
  legacyReport                ProductResearchReport?

  @@unique([organizationId, workspaceScopeKey, businessDate, configVersion, attempt])
  @@index([organizationId, businessDate])
  @@index([workspaceId, businessDate])
  @@index([status, businessDate])
  @@index([automationRunId])
  @@map("product_research_runs")
}

