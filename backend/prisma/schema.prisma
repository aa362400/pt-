// ──────────────────────────────────────────────
// ShopMate AI — E-Commerce AI SaaS Backend
// Prisma Schema — PostgreSQL
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_ADMIN_URL")
}

// ══════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════

