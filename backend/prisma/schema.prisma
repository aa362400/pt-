// ══════════════════════════════════════════════
// MODELS
// ══════════════════════════════════════════════

// ── 1. User ──────────────────────────────────
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  locale              String    @default("zh-CN")
  timezone            String    @default("Asia/Shanghai")
  status              String    @default("ACTIVE")
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  memberships                 Membership[]
  createdTasks                TeamTask[]               @relation("TaskCreator")
  assignedTasks               TeamTask[]               @relation("TaskAssignee")
  createdPrompts              PromptTemplate[]
  sessions                    AssistantSession[]
  agentRuns                   AgentRun[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  agentCapabilityTokens       AgentCapabilityToken[]
  createdSops                 Sop[]
  createdReports              ProductResearchReport[]
  createdKeywordRpt           KeywordReport[]
  createdListings             ListingDraft[]
  createdProfitCalc           ProfitCalculation[]
  createdImageProj            ImagePromptProject[]
  knowledgeDocs               KnowledgeDocument[]      @relation("DocCreator")
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  autonomyPolicies            AgentAutonomyPolicy[]
  marketObservationBatches    MarketObservationBatch[]
  productOpportunitiesCreated ProductOpportunity[]

  @@index([lockedUntil])
  @@map("users")
}

// ── 1b. RefreshToken (rotation + revocation) ──
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model DeadLetterJob {
  id                   String                     @id @default(cuid())
  organizationId       String?
  queueName            String
  jobId                String
  data                 Json
  failedReason         String?
  failedAttempts       Int                        @default(0)
  failedAt             DateTime                   @default(now())
  classification       DeadLetterClassification   @default(UNCLASSIFIED)
  classificationReason String?
  replayEligible       Boolean                    @default(false)
  classifiedAt         DateTime?
  classifiedBy         String?
  resolutionStatus     DeadLetterResolutionStatus @default(OPEN)
  replayClaimedAt      DateTime?
  replayClaimedBy      String?
  replayReason         String?
  replayIdempotencyKey String?
  replayRunId          String?
  resolvedAt           DateTime?
  resolvedBy           String?
  inspectedAt          DateTime?
  notes                String?
  createdAt            DateTime                   @default(now())

  @@index([queueName])
  @@index([organizationId])
  @@index([failedAt])
  @@index([inspectedAt])
  @@index([organizationId, resolutionStatus, replayClaimedAt])
  @@index([organizationId, resolutionStatus, classification])
  @@map("dead_letter_jobs")
}

// ── 2. Organization ──────────────────────────
model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  plan             Plan      @default(FREE)
  trialEndsAt      DateTime?
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  memberships                        Membership[]
  workspaces                         Workspace[]
  fileAssets                         FileAsset[]
  knowledgeDocs                      KnowledgeDocument[]
  sops                               Sop[]
  tasks                              TeamTask[]
  promptTemplates                    PromptTemplate[]
  sessions                           AssistantSession[]
  agentRuns                          AgentRun[]
  marketplaceOrders                  MarketplaceOrder[]
  automationFlows                    AutomationFlow[]
  automationStepExecutions           AutomationStepExecution[]
  alerts                             Alert[]
  trendInsights                      TrendInsight[]
  researchReports                    ProductResearchReport[]
  keywordReports                     KeywordReport[]
  listingDrafts                      ListingDraft[]
  profitCalcs                        ProfitCalculation[]
  imageProjects                      ImagePromptProject[]
  notifications                      Notification[]
  actionProposals                    ActionProposal[]
  approvalDecisions                  ApprovalDecision[]
  listingSandboxReports              ListingSandboxReport[]
  policyRuleHits                     PolicyRuleHit[]
  auditLogs                          AuditLog[]
  auditChainHead                     AuditChainHead?
  auditArchives                      AuditArchive[]
  reviewTasks                        ReviewTask[]
  productLaunches                    ProductLaunch[]
  listingPublishSnapshots            ListingPublishSnapshot[]
  externalSubmissions                ExternalSubmission[]
  agentWorkMemories                  AgentWorkMemory[]
  agentExperienceCards               AgentExperienceCard[]
  agentAutonomyMetrics               AgentAutonomyDailyMetric[]
  enterpriseSloSnapshots             EnterpriseSloDailySnapshot[]
  productResearchCandidateDecisions  ProductResearchCandidateDecision[]
  invoices                           Invoice[]
  suppliers                          Supplier[]
  supplySkus                         SupplySku[]
  replenishmentPlans                 ReplenishmentPlan[]
  mcpToolInvocations                 McpToolInvocation[]
  agentCapabilityTokens              AgentCapabilityToken[]
  productResearchRuns                ProductResearchRun[]
  productCandidates                  ProductCandidate[]
  productSignals                     ProductSignal[]
  productRiskRecords                 ProductRiskRecord[]
  productScores                      ProductScore[]
  scoringVersions                    ScoringVersion[]
  productResearchSourceHealth        ProductResearchSourceHealth[]
  productFeedback                    ProductFeedback[]
  researchReportArtifacts            ResearchReportArtifact[]
  supplierQuoteEvidence              SupplierQuoteEvidence[]
  supplierImageSearchEvidence        SupplierImageSearchEvidence[]
  candidateEconomicsEvidence         CandidateEconomicsEvidence[]
  candidateEconomicsEvaluations      CandidateEconomicsEvaluation[]
  candidateEconomicsEvaluationInputs CandidateEconomicsEvaluationInput[]
  autonomyPolicies                   AgentAutonomyPolicy[]
  agentPlans                         AgentPlan[]
  agentToolExecutions                AgentToolExecution[]
  marketObservationBatches           MarketObservationBatch[]
  marketObservationItems             MarketObservationItem[]
  productOpportunities               ProductOpportunity[]
  businessOutcomes                   BusinessOutcome[]
  feedbackSignals                    FeedbackSignal[]
  agentEvalSnapshots                 AgentEvalSnapshot[]
  promptVersions                     PromptVersion[]
  routerDecisionLogs                 RouterDecisionLog[]
  trainingJobs                       TrainingJob[]

  @@index([plan])
  @@index([slug])
  @@map("organizations")
}

// ── 3. Membership ────────────────────────────
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("memberships")
}

// ── 4. Workspace ─────────────────────────────
model Workspace {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  channelType    ChannelType
  marketplace    String?
  currency       String      @default("USD")
  timezone       String      @default("Asia/Shanghai")
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())

  // Relations
  organization                       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConns                       ChannelConnection[]
  products                           Product[]
  storeMetrics                       StoreMetricSnapshot[]
  agentRuns                          AgentRun[]
  marketplaceOrders                  MarketplaceOrder[]
  automationFlows                    AutomationFlow[]
  alerts                             Alert[]
  trendInsights                      TrendInsight[]
  researchReports                    ProductResearchReport[]
  keywordReports                     KeywordReport[]
  listingDrafts                      ListingDraft[]
  profitCalcs                        ProfitCalculation[]
  imageProjects                      ImagePromptProject[]
  sessions                           AssistantSession[]
  tasks                              TeamTask[]
  knowledgeDocs                      KnowledgeDocument[]
  fileAssets                         FileAsset[]
  agentWorkMemories                  AgentWorkMemory[]
  agentExperienceCards               AgentExperienceCard[]
  storeAgentProfile                  StoreAgentProfile?
  productResearchCandidateDecisions  ProductResearchCandidateDecision[]
  suppliers                          Supplier[]
  supplySkus                         SupplySku[]
  replenishmentPlans                 ReplenishmentPlan[]
  mcpToolInvocations                 McpToolInvocation[]
  agentCapabilityTokens              AgentCapabilityToken[]
  productResearchRuns                ProductResearchRun[]
  productCandidates                  ProductCandidate[]
  productSignals                     ProductSignal[]
  productRiskRecords                 ProductRiskRecord[]
  productScores                      ProductScore[]
  scoringVersions                    ScoringVersion[]
  productResearchSourceHealth        ProductResearchSourceHealth[]
  productFeedback                    ProductFeedback[]
  researchReportArtifacts            ResearchReportArtifact[]
  supplierQuoteEvidence              SupplierQuoteEvidence[]
  supplierImageSearchEvidence        SupplierImageSearchEvidence[]
  candidateEconomicsEvidence         CandidateEconomicsEvidence[]
  candidateEconomicsEvaluations      CandidateEconomicsEvaluation[]
  candidateEconomicsEvaluationInputs CandidateEconomicsEvaluationInput[]
  marketObservationBatches           MarketObservationBatch[]
  productOpportunities               ProductOpportunity[]
  businessOutcomes                   BusinessOutcome[]

  @@index([organizationId])
  @@index([channelType])
  @@index([status])
  @@map("workspaces")
}

// ── 5. ChannelConnection ─────────────────────
model ChannelConnection {
  id                    String            @id @default(cuid())
  workspaceId           String
  provider              String
  externalShopId        String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  syncStatus            ChannelSyncStatus @default(PENDING)
  lastSyncedAt          DateTime?

  // Relations
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders    MarketplaceOrder[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider])
  @@index([syncStatus])
  @@map("channel_connections")
}

// ── 6. Product ───────────────────────────────
model Product {
  id               String        @id @default(cuid())
  workspaceId      String
  title            String
  sku              String?
  asinOrExternalId String?
  images           String[]
  cost             Decimal       @default(0)
  price            Decimal       @default(0)
  currency         String        @default("USD")
  status           ProductStatus @default(DRAFT)
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now())

  // Relations
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listingDrafts   ListingDraft[]
  profitCalcs     ProfitCalculation[]
  imageProjects   ImagePromptProject[]
  productLaunches ProductLaunch[]
  supplySkus      SupplySku[]

  @@index([workspaceId])
  @@index([sku])
  @@index([asinOrExternalId])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

// ── 7. FileAsset ─────────────────────────────
model FileAsset {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String?
  ownerId        String
  filename       String
  mimeType       String
  size           Int
  storageKey     String
  sha256         String?
  publicUrl      String?
  purpose        FilePurpose
  createdAt      DateTime    @default(now())

  imageProjectReferences  ImagePromptProject[] @relation("ImageProjectReferenceAsset")
  productLaunchReferences ProductLaunch[]      @relation("ProductLaunchReferenceAsset")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([purpose])
  @@map("file_assets")
}

// ── 8. KnowledgeDocument ─────────────────────
model KnowledgeDocument {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String?
  title          String
  content        String
  fileAssetId    String?
  tags           String[]           @default([])
  visibility     DocumentVisibility @default(ORGANIZATION)
  createdBy      String
  createdAt      DateTime           @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator      User         @relation("DocCreator", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdBy])
  @@index([visibility])
  @@index([title])
  @@map("knowledge_documents")
}

// ── 9. Sop ────────────────────────────────────
model Sop {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         SopStatus @default(DRAFT)
  steps          Json      @default("[]")
  createdBy      String
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
  @@map("sops")
}

// ── 10. TeamTask ──────────────────────────────
model TeamTask {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String?
  title          String
  description    String?
  assigneeId     String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  dueAt          DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator      User         @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([createdBy])
  @@index([status])
  @@index([priority])
  @@map("team_tasks")
}

// ── 11. PromptTemplate ────────────────────────
model PromptTemplate {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  category       String
  content        String
  variables      Json     @default("[]")
  usageCount     Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([category])
  @@index([createdBy])
  @@map("prompt_templates")
}

// ── 12. AssistantSession ──────────────────────
model AssistantSession {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String?
  userId         String
  title          String
  contextType    SessionContextType @default(GENERAL)
  status         SessionStatus      @default(ACTIVE)
  autonomyLevel  Int                @default(1)
  allowedDomains String[]           @default([])
  context        Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id])
  messages     AssistantMessage[]
  plans        AgentPlan[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([contextType])
  @@index([status])
  @@map("assistant_sessions")
}

model AgentAutonomyPolicy {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String?
  scopeKey         String
  level            Int      @default(1)
  allowedTools     String[] @default([])
  deniedTools      String[] @default([])
  highRiskApproval Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeKey])
  @@index([organizationId, userId])
  @@map("agent_autonomy_policies")
}

model AgentPlan {
  id             String   @id @default(cuid())
  conversationId String
  organizationId String
  goal           String
  status         String   @default("PLANNED")
  plan           Json
  result         Json?
  error          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AssistantSession     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentToolExecution[]

  @@index([organizationId, status])
  @@index([conversationId, createdAt])
  @@map("agent_plans")
}

model AgentToolExecution {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  toolName       String
  toolVersion    String
  status         String    @default("PLANNED")
  riskLevel      String
  idempotencyKey String
  inputHash      String
  input          Json
  output         Json?
  error          Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

