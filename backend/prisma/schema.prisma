  productId        String?
  referenceAssetId String?
  mode             ImageMode          @default(SINGLE)
  prompt           String?
  settings         Json               @default("{}")
  generatedAssets  Json               @default("[]")
  qaStatus         ImageQaStatus      @default(PENDING)
  qaVersion        String             @default("visual-qa/v1")
  qaResult         Json               @default("{}")
  qaCompletedAt    DateTime?
  status           ImageProjectStatus @default(DRAFT)
  createdBy        String
  createdAt        DateTime           @default(now())

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  referenceAsset  FileAsset?      @relation("ImageProjectReferenceAsset", fields: [referenceAssetId], references: [id], onDelete: SetNull)
  productLaunches ProductLaunch[] @relation("ProductLaunchImageProject")
  creator         User            @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([productId])
  @@index([referenceAssetId])
  @@index([qaStatus])
  @@index([createdBy])
  @@index([status])
  @@map("image_prompt_projects")
}

// ── 25. Notification ──────────────────────────
model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  readAt         DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionProposal ActionProposal?

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model ActionProposal {
  id                       String               @id @default(cuid())
  organizationId           String
  notificationId           String               @unique
  requestedBy              String
  approverId               String
  source                   String
  action                   String
  params                   Json
  context                  Json                 @default("{}")
  payloadHash              String
  dedupeKey                String
  version                  Int                  @default(1)
  activeDedupeSlot         String?              @default("ACTIVE")
  status                   ActionProposalStatus @default(PENDING)
  executionAttempt         Int                  @default(0)
  lastHeartbeatAt          DateTime?
  executionGrantHash       String?              @unique
  executionGrantScope      String?
  executionGrantDecisionId String?
  executionGrantExpiresAt  DateTime?
  executionGrantConsumedAt DateTime?
  result                   Json?
  error                    String?
  expiresAt                DateTime
  claimedAt                DateTime?
  decidedAt                DateTime?
  executedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  decisions    ApprovalDecision[]

  @@unique([organizationId, dedupeKey, activeDedupeSlot])
  @@index([organizationId, status])
  @@index([organizationId, approverId, status])
  @@index([organizationId, executionGrantDecisionId])
  @@index([executionGrantExpiresAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("action_proposals")
}

model ApprovalDecision {
  id               String               @id @default(cuid())
  organizationId   String
  actionProposalId String
  decision         ApprovalDecisionType
  actorId          String
  actorRole        String
  reason           String?
  payloadHash      String
  sandboxReportId  String?
  metadata         Json                 @default("{}")
  createdAt        DateTime             @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionProposal ActionProposal        @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  sandboxReport  ListingSandboxReport? @relation(fields: [sandboxReportId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actionProposalId])
  @@index([decision])
  @@index([actorId])
  @@index([createdAt])
  @@map("approval_decisions")
}

// ── 26. UserConsent ──────────────────────────
model UserConsent {
  id          String   @id @default(cuid())
  userId      String
  type        String // 'privacy' or 'terms'
  version     String
  consentedAt DateTime @default(now())
  ip          String?

  @@index([userId])
  @@index([type, version])
  @@map("user_consents")
}

// ── 27. AuditLog ──────────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  action         String
  resourceType   String
  resourceId     String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  sequence       BigInt?
  previousHash   String?
  entryHash      String?  @unique
  hashAlgorithm  String?  @default("SHA-256")
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  @@unique([organizationId, sequence])
  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AuditChainHead {
  organizationId String   @id
  lastSequence   BigInt   @default(0)
  lastHash       String
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("audit_chain_heads")
}

model AuditArchive {
  id                String   @id @default(cuid())
  organizationId    String
  date              DateTime
  objectKey         String   @unique
  contentHash       String
  entryCount        Int
  firstSequence     BigInt
  lastSequence      BigInt
  firstPreviousHash String
  finalHash         String
  versionId         String
  objectLockMode    String
  retainUntil       DateTime
  verifiedAt        DateTime
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([retainUntil])
  @@map("audit_archives")
}

// ── 28. ReviewTask (Human review queue for generated content) ──
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REWORK
}

enum ReviewEntityType {
  AGENT_RUN
  IMAGE_GENERATION
  LISTING_DRAFT
  PRODUCT_RESEARCH
  SUPPLY_PLAN
}

enum ProductLaunchStatus {
  QUEUED
  GENERATING_IMAGES
  AWAITING_PUBLISH_APPROVAL
  SUBMITTING_TO_OZON
  RECOVERING
  SUBMITTED_TO_OZON
  ACTIVE_ON_OZON
  BLOCKED
  FAILED
}

enum ListingPublishSnapshotStatus {
  APPROVED
  SUBMITTING
  SUBMITTED
  ACTIVE
  BLOCKED
  FAILED
}

enum ExternalSubmissionStatus {
  PREPARED
  CLAIMED
  REQUEST_SENT
  ACKNOWLEDGED
  SUCCEEDED
  REJECTED
  UNKNOWN
  RETRYABLE_FAILED
  RECONCILING
}

model ReviewTask {
  id                String           @id @default(cuid())
  organizationId    String
  entityType        ReviewEntityType
  entityId          String
  status            ReviewStatus     @default(PENDING)
  score             Float? // consistency score 0-100
  threshold         Float            @default(60.0)
  autoApproved      Boolean          @default(false)
  autoRegenerations Int              @default(0)
  assignedTo        String? // reviewer user ID
  notes             String?
  approvalScope     Json             @default("{}")
  decisionEvidence  Json             @default("{}")
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productLaunches ProductLaunch[]

  @@index([organizationId])
  @@index([entityType])
  @@index([entityId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("review_tasks")
}

// A durable record of a human-confirmed candidate launch. It keeps image
// generation, Ozon submission, and failure evidence separate from the generic
// review status so a local draft is never represented as a published product.
model ProductLaunch {
  id                                String              @id @default(cuid())
  organizationId                    String
  reviewTaskId                      String
  reportId                          String
  candidateId                       String
  candidateIndex                    Int
  researchCandidateId               String?
  economicsEvaluationId             String?
  economicsEvaluationHash           String?
  productId                         String?
  imageProjectId                    String?
  referenceAssetId                  String?
  referenceAssetSha256              String?
  agentRunId                        String?
  channelId                         String?
  status                            ProductLaunchStatus @default(QUEUED)
  imageGenerationApproved           Boolean             @default(false)
  confirmAutoPublish                Boolean             @default(false)
  listingDraftId                    String?
  publishReviewTaskId               String?
  approvedContentHash               String?
  selectedPublishSnapshotId         String?             @unique
  approvedPublishSnapshotHash       String?
  publishApprovedBy                 String?
  publishApprovedAt                 DateTime?
  publishExecutionGrantHash         String?             @unique
  publishExecutionGrantScope        String?
  publishExecutionGrantSnapshotHash String?
  publishExecutionGrantExpiresAt    DateTime?
  publishExecutionGrantConsumedAt   DateTime?
  requestedBy                       String
  failureCode                       String?
  failureMessage                    String?
  execution                         Json                @default("{}")
  startedAt                         DateTime?
  completedAt                       DateTime?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt

  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewTask              ReviewTask                    @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)
  product                 Product?                      @relation(fields: [productId], references: [id], onDelete: SetNull)
  referenceAsset          FileAsset?                    @relation("ProductLaunchReferenceAsset", fields: [referenceAssetId], references: [id], onDelete: SetNull)
  imageProject            ImagePromptProject?           @relation("ProductLaunchImageProject", fields: [imageProjectId], references: [id], onDelete: SetNull)
  selectedPublishSnapshot ListingPublishSnapshot?       @relation("SelectedPublishSnapshot", fields: [selectedPublishSnapshotId], references: [id], onDelete: SetNull)
  publishSnapshots        ListingPublishSnapshot[]      @relation("LaunchPublishSnapshots")
  externalSubmissions     ExternalSubmission[]
  researchCandidate       ProductCandidate?             @relation(fields: [researchCandidateId], references: [id], onDelete: Restrict)
  economicsEvaluation     CandidateEconomicsEvaluation? @relation(fields: [economicsEvaluationId], references: [id], onDelete: Restrict)

  @@unique([reviewTaskId, candidateId])
  @@index([organizationId])
  @@index([reviewTaskId])
  @@index([productId])
  @@index([imageProjectId])
  @@index([referenceAssetId])
  @@index([researchCandidateId])
  @@index([economicsEvaluationId])
  @@index([status])
  @@index([publishExecutionGrantExpiresAt])
  @@index([createdAt])
  @@map("product_launches")
}

model ListingPublishSnapshot {
  id                      String                       @id @default(cuid())
  organizationId          String
  productLaunchId         String
  listingDraftId          String
  reviewTaskId            String
  productId               String
  channelId               String
  target                  String                       @default("OZON")
  schemaVersion           String                       @default("listing-publish-snapshot/v2")
  listingApprovalHash     String
  economicsEvaluationId   String?
  economicsEvaluationHash String?
  economicsInputSetHash   String?
  economicsValidUntil     DateTime?
  snapshot                Json
  snapshotHash            String
  status                  ListingPublishSnapshotStatus @default(APPROVED)
  approvedBy              String
  approvedAt              DateTime
  result                  Json                         @default("{}")
  failureCode             String?
  failureMessage          String?
  submittedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productLaunch       ProductLaunch                 @relation("LaunchPublishSnapshots", fields: [productLaunchId], references: [id], onDelete: Cascade)
  selectedForLaunch   ProductLaunch?                @relation("SelectedPublishSnapshot")
  externalSubmission  ExternalSubmission?
  sandboxReport       ListingSandboxReport?
  economicsEvaluation CandidateEconomicsEvaluation? @relation(fields: [economicsEvaluationId], references: [id], onDelete: Restrict)

  @@unique([productLaunchId, snapshotHash])
  @@index([organizationId])
  @@index([productLaunchId])
  @@index([listingDraftId])
  @@index([reviewTaskId])
  @@index([productId])
  @@index([channelId])
  @@index([economicsEvaluationId])
  @@index([status])
  @@index([createdAt])
  @@map("listing_publish_snapshots")
}

model ListingSandboxReport {
  id                String                  @id @default(cuid())
  organizationId    String
  publishSnapshotId String                  @unique
  snapshotHash      String
  target            String                  @default("OZON")
  policyVersion     String
  status            ListingSandboxStatus
  riskLevel         ListingSandboxRiskLevel
  blocking          Boolean                 @default(false)
  summary           Json                    @default("{}")
  evaluatedAt       DateTime                @default(now())
  overriddenBy      String?
  overrideReason    String?
  overriddenAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishSnapshot   ListingPublishSnapshot @relation(fields: [publishSnapshotId], references: [id], onDelete: Cascade)
  ruleHits          PolicyRuleHit[]
  approvalDecisions ApprovalDecision[]

  @@index([organizationId])
  @@index([snapshotHash])
  @@index([status])
  @@index([riskLevel])
  @@index([evaluatedAt])
  @@map("listing_sandbox_reports")
}

model PolicyRuleHit {
  id              String                  @id @default(cuid())
  organizationId  String
  sandboxReportId String
  ruleCode        String
  category        String
  severity        ListingSandboxRiskLevel
  blocking        Boolean                 @default(false)
  message         String
  evidence        Json                    @default("{}")
  createdAt       DateTime                @default(now())

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sandboxReport ListingSandboxReport @relation(fields: [sandboxReportId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sandboxReportId])
  @@index([ruleCode])
  @@index([severity])
  @@index([createdAt])
  @@map("policy_rule_hits")
}

// Durable outbound request ledger. A snapshot may be dispatched at most once;
// an ambiguous network outcome must be reconciled before any further action.
model ExternalSubmission {
  id                      String                   @id @default(cuid())
  organizationId          String
  productLaunchId         String
  publishSnapshotId       String                   @unique
  provider                String                   @default("OZON")
  operation               String                   @default("PRODUCT_PUBLISH")
  idempotencyKey          String
  requestHash             String
  payloadHash             String?
  economicsEvaluationId   String?
  economicsEvaluationHash String?
  status                  ExternalSubmissionStatus @default(PREPARED)
  attemptCount            Int                      @default(0)
  claimToken              String?
  claimedAt               DateTime?
  request                 Json                     @default("{}")
  result                  Json                     @default("{}")
  reconciliationResult    Json                     @default("{}")
  externalTaskId          String?
  externalProductId       String?
  failureCode             String?
  failureMessage          String?
  requestSentAt           DateTime?
  responseReceivedAt      DateTime?
  acknowledgedAt          DateTime?
  resolvedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productLaunch       ProductLaunch                 @relation(fields: [productLaunchId], references: [id], onDelete: Cascade)
  publishSnapshot     ListingPublishSnapshot        @relation(fields: [publishSnapshotId], references: [id], onDelete: Cascade)
  economicsEvaluation CandidateEconomicsEvaluation? @relation(fields: [economicsEvaluationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider, idempotencyKey])
  @@index([organizationId])
  @@index([productLaunchId])
  @@index([economicsEvaluationId])
  @@index([status])
  @@index([status, claimedAt])
  @@index([createdAt])
  @@map("external_submissions")
}

// ── 30. AgentWorkMemory (durable work history) ──
model AgentWorkMemory {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  agentRunId      String?
  productId       String?
  productName     String?
  taskType        String
  status          String
  score           Float?
  reviewStatus    String?
  reviewNotes     String?
  durationSeconds Float    @default(0)
  result          Json?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([agentRunId])
  @@index([productId])
  @@index([productName])
  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@map("agent_work_memories")
}

// ── 31. AgentExperienceCard (review learning) ──
model AgentExperienceCard {
  id                 String   @id @default(cuid())
  organizationId     String
  workspaceId        String?
  sourceReviewTaskId String?
  taskType           String?
  entityType         String?
  category           String
  title              String
  lesson             String
  evidence           Json     @default("{}")
  scoreImpact        Float?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([sourceReviewTaskId])
  @@index([taskType])
  @@index([entityType])
  @@index([category])
  @@index([createdAt])
  @@map("agent_experience_cards")
}

// ── 32. AgentAutonomyDailyMetric (stage-20 readiness ledger) ──
model AgentAutonomyDailyMetric {
  id                       String   @id @default(cuid())
  organizationId           String
  date                     DateTime
  taskSuccessRate          Float
  suggestionAdoptionRate   Float
  autonomousCompletionRate Float
  memoryQueryAccuracy      Float
  unauthorizedActionCount  Int      @default(0)
  totalTasks               Int      @default(0)
  successfulTasks          Int      @default(0)
  totalSuggestions         Int      @default(0)
  acceptedSuggestions      Int      @default(0)
  autonomousCompletions    Int      @default(0)
  memoryQaTotal            Int      @default(0)
  memoryQaCorrect          Int      @default(0)
  passed                   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([passed])
  @@map("agent_autonomy_daily_metrics")
}

// A fact-only daily ledger for enterprise SLO acceptance. A day cannot pass
// when any required evidence source is absent, and the 14-day claim is derived
// from consecutive calendar dates rather than a manually supplied counter.
model EnterpriseSloDailySnapshot {
  id                              String   @id @default(cuid())
  organizationId                  String
  date                            DateTime
  totalTasks                      Int      @default(0)
  successfulTasks                 Int      @default(0)
  taskSuccessRate                 Float?
  qualitySamples                  Int      @default(0)
  qualityPassed                   Int      @default(0)
  qualityPassRate                 Float?
  autonomousCompletions           Int      @default(0)
  autonomousCompletionRate        Float?
  totalSuggestions                Int      @default(0)
  acceptedSuggestions             Int      @default(0)
  suggestionAdoptionRate          Float?
  unauthorizedActionCount         Int      @default(0)
  blockedUnauthorizedAttemptCount Int      @default(0)
  p95LatencyMs                    Int?
  queueBacklog                    Int      @default(0)
  queueEvidenceAvailable          Boolean  @default(false)
  unresolvedDeadLetters           Int      @default(0)
  totalCostAmount                 Decimal  @default(0)
  costSampleCount                 Int      @default(0)
  averageCostPerTask              Decimal?
  errorBudgetConsumed             Float?
  dataComplete                    Boolean  @default(false)
  missingEvidence                 String[] @default([])
  passed                          Boolean  @default(false)
  evidence                        Json     @default("{}")
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([passed])
  @@map("enterprise_slo_daily_snapshots")
}

// ── 29. Invoice (Billing) ─────────────────────────
model Invoice {
  id              String    @id @default(cuid())
  organizationId  String
  amount          Decimal
  currency        String    @default("USD")
  status          String    @default("PENDING") // PENDING / PAID / FAILED / REFUNDED
  plan            String
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  stripeInvoiceId String?   @unique
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

// Global provider-event ledger. It deliberately stores only routing metadata,
// never the raw Stripe payload, so webhook idempotency does not retain payment
// secrets or unnecessary customer data.
model StripeWebhookEvent {
  id                     String    @id @default(cuid())
  provider               String    @default("STRIPE")
  providerEventId        String
  livemode               Boolean
  eventType              String
  objectId               String?
  resolvedOrganizationId String?
  processedAt            DateTime?
  createdAt              DateTime  @default(now())

  @@unique([provider, livemode, providerEventId])
  @@index([eventType, createdAt])
  @@index([resolvedOrganizationId, createdAt])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}

// ── 30. FeatureFlag (Gray release / canary rollout) ──
model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  orgIds    String[] @default([]) // allowlisted org IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([enabled])
  @@map("feature_flags")
}
