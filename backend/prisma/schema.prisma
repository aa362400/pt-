  supplierQuotes              SupplierQuoteEvidence[]
  supplierImageSearchEvidence SupplierImageSearchEvidence[]
  economicsEvidence           CandidateEconomicsEvidence[]
  economicsEvaluations        CandidateEconomicsEvaluation[]
  economicsEvaluationInputs   CandidateEconomicsEvaluationInput[]
  productLaunches             ProductLaunch[]

  @@unique([researchRunId, fingerprint])
  @@index([organizationId, fingerprint, lastSeenAt])
  @@index([workspaceId, status])
  @@index([researchRunId, status])
  @@map("product_candidates")
}

// Immutable, append-only normalized supplier quote evidence. Search results
// never overwrite Supplier/SupplySku master data and are revalidated at use time.
model SupplierQuoteEvidence {
  id                String  @id @default(cuid())
  organizationId    String
  workspaceId       String?
  workspaceScopeKey String
  researchRunId     String
  candidateId       String

  schemaVersion      String
  provider           String
  adapterVersion     String
  requestId          String
  evidenceGroupKey   String
  discoveryMethod    String
  matchStatus        String
  verificationStatus String

  sourceOriginalSha256  String?
  sourceCanonicalSha256 String?
  offerCanonicalSha256  String?

  offerId              String
  offerUrl             String
  variantId            String
  variantAttributes    Json
  quantity             Int
  minimumOrderQuantity Int
  unitOfMeasure        String
  unitsPerPack         Int

  priceKind            String
  productUnitAmount    Decimal? @db.Decimal(18, 4)
  productTotalAmount   Decimal? @db.Decimal(18, 4)
  displayMinimumAmount Decimal? @db.Decimal(18, 4)
  displayMaximumAmount Decimal? @db.Decimal(18, 4)
  productCurrency      String

  shippingQuoteId               String
  shippingScope                 String
  shippingDestinationCountry    String
  shippingDestinationPostalCode String
  shippingQuantity              Int
  shippingUnitAmount            Decimal @db.Decimal(18, 4)
  shippingTotalAmount           Decimal @db.Decimal(18, 4)
  shippingCurrency              String
  shippingEvidenceUrl           String

  attributeConflicts Json
  expectedBinding    Json
  normalizedEvidence Json
  rawSnapshotSha256  String
  rawSnapshotRef     String?
  contentHash        String
  dedupeKey          String

  fetchedAt  DateTime
  verifiedAt DateTime
  validUntil DateTime
  createdAt  DateTime @default(now())

  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace            Workspace?                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchRun          ProductResearchRun             @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  candidate            ProductCandidate               @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  economicsEvaluations CandidateEconomicsEvaluation[]

  @@unique([organizationId, workspaceScopeKey, dedupeKey])
  @@unique([organizationId, workspaceScopeKey, provider, requestId])
  @@index([researchRunId, candidateId])
  @@index([candidateId, verificationStatus, validUntil])
  @@index([organizationId, evidenceGroupKey, createdAt])
  @@map("supplier_quote_evidence")
}

// Immutable image-search discovery evidence. Displayed prices remain strings
// inside normalizedOffers and can never be consumed as verified procurement cost.
model SupplierImageSearchEvidence {
  id                String  @id @default(cuid())
  organizationId    String
  workspaceId       String?
  workspaceScopeKey String
  researchRunId     String
  candidateId       String

  schemaVersion  String
  provider       String
  adapterVersion String
  requestId      String
  outcome        String

  rawSnapshotSha256       String
  canonicalizationVersion String
  sourceOriginalSha256    String
  sourceCanonicalSha256   String
  canonicalByteSize       Int
  canonicalMimeType       String
  canonicalWidth          Int
  canonicalHeight         Int
  retrievalHashAlgorithm  String
  retrievalHash           String

  providerResultCount         Int
  normalizedOffers            Json
  fetchedAt                   DateTime
  contentCanonicalizerVersion String
  contentHash                 String
  dedupeKey                   String
  createdAt                   DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchRun  ProductResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
