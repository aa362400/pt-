  @@unique([organizationId, dedupeKey])
  @@unique([organizationId, workspaceScopeKey, requestId])
  @@index([researchRunId, candidateId])
  @@index([candidateId, createdAt])
  @@index([organizationId, provider, fetchedAt])
  @@map("supplier_image_search_evidence")
}

// Immutable, append-only atomic economics facts. Every VERIFIED fact is bound
// to an exact candidate shape and an immutable raw response snapshot.
model CandidateEconomicsEvidence {
  id                String  @id @default(cuid())
  organizationId    String
  workspaceId       String?
  workspaceScopeKey String
  researchRunId     String
  candidateId       String

  schemaVersion String
  kind          String
  valueKind     String
  amount        Decimal? @db.Decimal(18, 4)
  rate          Decimal? @db.Decimal(18, 8)
  minimumAmount Decimal? @db.Decimal(18, 4)
  currency      String?
  baseCurrency  String?
  quoteCurrency String?
  quantity      Decimal? @db.Decimal(18, 4)
  unit          String?

  provider           String
  adapterVersion     String
  requestId          String
  verificationMethod String
  verificationStatus String
  binding            Json
  bindingHash        String
  normalizedEvidence Json
  rawSnapshotSha256  String
  rawSnapshotRef     String
  contentHash        String
  dedupeKey          String

  observedAt DateTime
  fetchedAt  DateTime
  verifiedAt DateTime
  validUntil DateTime
  createdAt  DateTime @default(now())

  organization     Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace        Workspace?                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchRun      ProductResearchRun                  @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  candidate        ProductCandidate                    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  evaluationInputs CandidateEconomicsEvaluationInput[]

  @@unique([organizationId, workspaceScopeKey, dedupeKey], map: "candidate_econ_evidence_scope_dedupe_key")
  @@unique([organizationId, workspaceScopeKey, provider, requestId], map: "candidate_econ_evidence_scope_request_key")
  @@index([researchRunId, candidateId])
  @@index([candidateId, kind, verificationStatus, validUntil])
  @@index([organizationId, provider, fetchedAt])
  @@map("candidate_economics_evidence")
}

// Deterministic conclusion over one exact immutable evidence set. BLOCKED
// evaluations preserve missing-data reasons; only fresh VERIFIED/PASS rows may
// authorize a publish snapshot.
model CandidateEconomicsEvaluation {
  id                      String  @id @default(cuid())
  organizationId          String
  workspaceId             String?
  workspaceScopeKey       String
  researchRunId           String
  candidateId             String
  supplierQuoteEvidenceId String?

  schemaVersion      String
  policyVersion      String
  calculatorVersion  String
  policySnapshot     Json
  policyHash         String
  inputSetHash       String
  rawSnapshotSetHash String
  contentHash        String
  dedupeKey          String

  status               String
  decision             String
  currency             String
  salePrice            Decimal? @db.Decimal(18, 4)
  grossProfitBeforeAds Decimal? @db.Decimal(18, 4)
  grossMarginBeforeAds Decimal? @db.Decimal(18, 8)
  netProfitAfterAds    Decimal? @db.Decimal(18, 4)
  netMarginAfterAds    Decimal? @db.Decimal(18, 8)
  totalCost            Decimal? @db.Decimal(18, 4)
  componentBreakdown   Json
  hardGateReasons      String[] @default([])

  validFrom  DateTime
  validUntil DateTime
  createdAt  DateTime @default(now())

  organization        Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace           Workspace?                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchRun         ProductResearchRun                  @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  candidate           ProductCandidate                    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  supplierQuote       SupplierQuoteEvidence?              @relation(fields: [supplierQuoteEvidenceId], references: [id], onDelete: Restrict)
  inputs              CandidateEconomicsEvaluationInput[]
  productLaunches     ProductLaunch[]
  publishSnapshots    ListingPublishSnapshot[]
  externalSubmissions ExternalSubmission[]

  @@unique([organizationId, workspaceScopeKey, candidateId, policyVersion, inputSetHash], map: "candidate_econ_eval_candidate_policy_input_key")
  @@unique([organizationId, workspaceScopeKey, dedupeKey], map: "candidate_econ_eval_scope_dedupe_key")
  @@index([researchRunId, candidateId])
  @@index([candidateId, status, decision, validUntil])
  @@index([supplierQuoteEvidenceId])
  @@map("candidate_economics_evaluations")
}

// Exact evidence membership for an evaluation. Parent columns are deliberately
// duplicated so PostgreSQL can reject cross-candidate or cross-workspace joins.
model CandidateEconomicsEvaluationInput {
  id                  String   @id @default(cuid())
  organizationId      String
  workspaceId         String?
  workspaceScopeKey   String
  researchRunId       String
  candidateId         String
  evaluationId        String
  economicsEvidenceId String
  role                String
  ordinal             Int
  evidenceContentHash String
  rawSnapshotSha256   String
  createdAt           DateTime @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    Workspace?                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchRun  ProductResearchRun           @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  candidate    ProductCandidate             @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  evaluation   CandidateEconomicsEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  evidence     CandidateEconomicsEvidence   @relation(fields: [economicsEvidenceId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, role, ordinal])
  @@unique([evaluationId, economicsEvidenceId])
  @@index([researchRunId, candidateId])
  @@index([economicsEvidenceId])
  @@map("candidate_economics_evaluation_inputs")
}

