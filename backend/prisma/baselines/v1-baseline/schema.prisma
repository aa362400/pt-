  queueBacklog                    Int          @default(0)
  queueEvidenceAvailable          Boolean      @default(false)
  unresolvedDeadLetters           Int          @default(0)
  totalCostAmount                 Decimal      @default(0)
  costSampleCount                 Int          @default(0)
  averageCostPerTask              Decimal?
  errorBudgetConsumed             Float?
  dataComplete                    Boolean      @default(false)
  missingEvidence                 String[]     @default([])
  passed                          Boolean      @default(false)
  evidence                        Json         @default("{}")
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  blockedUnauthorizedAttemptCount Int          @default(0)
  organization                    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([passed])
  @@map("enterprise_slo_daily_snapshots")
}

model Invoice {
  id              String       @id @default(cuid())
  organizationId  String
  amount          Decimal
  currency        String       @default("USD")
  status          String       @default("PENDING")
  plan            String
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  stripeInvoiceId String?      @unique
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model StripeWebhookEvent {
  id                     String    @id @default(cuid())
  provider               String    @default("STRIPE")
  providerEventId        String
  livemode               Boolean
  eventType              String
  objectId               String?
  resolvedOrganizationId String?
  processedAt            DateTime?
  createdAt              DateTime  @default(now())

  @@unique([provider, livemode, providerEventId])
  @@index([eventType, createdAt])
  @@index([resolvedOrganizationId, createdAt])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  orgIds    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([enabled])
  @@map("feature_flags")
}

