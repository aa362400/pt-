generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_ADMIN_URL")
}

model User {
  id                          String                   @id @default(cuid())
  email                       String                   @unique
  passwordHash                String
  name                        String
  avatarUrl                   String?
  locale                      String                   @default("zh-CN")
  timezone                    String                   @default("Asia/Shanghai")
  status                      String                   @default("ACTIVE")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  emailVerifiedAt             DateTime?
  twoFactorEnabled            Boolean                  @default(false)
  twoFactorSecret             String?
  failedLoginAttempts         Int                      @default(0)
  lockedUntil                 DateTime?
  lastFailedLoginAt           DateTime?
  autonomyPolicies            AgentAutonomyPolicy[]
  agentCapabilityTokens       AgentCapabilityToken[]
  agentRuns                   AgentRun[]
  sessions                    AssistantSession[]
  auditLogs                   AuditLog[]
  emailVerificationTokens     EmailVerificationToken[]
  createdImageProj            ImagePromptProject[]
  createdKeywordRpt           KeywordReport[]
  knowledgeDocs               KnowledgeDocument[]      @relation("DocCreator")
  createdListings             ListingDraft[]
  marketObservationBatches    MarketObservationBatch[]
  memberships                 Membership[]
  notifications               Notification[]
  passwordResetTokens         PasswordResetToken[]
  productOpportunitiesCreated ProductOpportunity[]
  createdReports              ProductResearchReport[]
  createdProfitCalc           ProfitCalculation[]
  createdPrompts              PromptTemplate[]
  refreshTokens               RefreshToken[]
  createdSops                 Sop[]
  assignedTasks               TeamTask[]               @relation("TaskAssignee")
  createdTasks                TeamTask[]               @relation("TaskCreator")

  @@index([lockedUntil])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model DeadLetterJob {
  id                   String                     @id @default(cuid())
  queueName            String
  jobId                String
  data                 Json
  failedReason         String?
  failedAt             DateTime                   @default(now())
  inspectedAt          DateTime?
  notes                String?
  createdAt            DateTime                   @default(now())
  organizationId       String?
  failedAttempts       Int                        @default(0)
  classification       DeadLetterClassification   @default(UNCLASSIFIED)
  classificationReason String?
  replayEligible       Boolean                    @default(false)
  classifiedAt         DateTime?
  classifiedBy         String?
  resolutionStatus     DeadLetterResolutionStatus @default(OPEN)
  replayRunId          String?
  resolvedAt           DateTime?
  resolvedBy           String?
  replayClaimedAt      DateTime?
  replayClaimedBy      String?

  @@index([queueName])
  @@index([organizationId])
  @@index([failedAt])
  @@index([inspectedAt])
  @@index([organizationId, resolutionStatus, classification], map: "dead_letter_jobs_organizationId_resolutionStatus_classification")
  @@index([organizationId, resolutionStatus, replayClaimedAt], map: "dead_letter_jobs_organizationId_resolutionStatus_replayClaimedA")
  @@map("dead_letter_jobs")
}

model Organization {
  id                                String                             @id @default(cuid())
  name                              String
  slug                              String                             @unique
  plan                              Plan                               @default(FREE)
  trialEndsAt                       DateTime?
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  stripeCustomerId                  String?                            @unique
  actionProposals                   ActionProposal[]
  agentAutonomyMetrics              AgentAutonomyDailyMetric[]
  autonomyPolicies                  AgentAutonomyPolicy[]
  agentCapabilityTokens             AgentCapabilityToken[]
  agentEvalSnapshots                AgentEvalSnapshot[]
  agentExperienceCards              AgentExperienceCard[]
  agentPlans                        AgentPlan[]
  agentRuns                         AgentRun[]
  agentToolExecutions               AgentToolExecution[]
  agentWorkMemories                 AgentWorkMemory[]
  alerts                            Alert[]
  approvalDecisions                 ApprovalDecision[]
  sessions                          AssistantSession[]
  auditArchives                     AuditArchive[]
  auditChainHead                    AuditChainHead?
  auditLogs                         AuditLog[]
  automationFlows                   AutomationFlow[]
  automationStepExecutions          AutomationStepExecution[]
  businessOutcomes                  BusinessOutcome[]
  enterpriseSloSnapshots            EnterpriseSloDailySnapshot[]
  externalSubmissions               ExternalSubmission[]
  feedbackSignals                   FeedbackSignal[]
  fileAssets                        FileAsset[]
  imageProjects                     ImagePromptProject[]
  invoices                          Invoice[]
  keywordReports                    KeywordReport[]
  knowledgeDocs                     KnowledgeDocument[]
  listingDrafts                     ListingDraft[]
  listingPublishSnapshots           ListingPublishSnapshot[]
  listingSandboxReports             ListingSandboxReport[]
  marketObservationBatches          MarketObservationBatch[]
  marketObservationItems            MarketObservationItem[]
  marketplaceOrders                 MarketplaceOrder[]
  mcpToolInvocations                McpToolInvocation[]
  memberships                       Membership[]
  notifications                     Notification[]
  policyRuleHits                    PolicyRuleHit[]
  productCandidates                 ProductCandidate[]
  productFeedback                   ProductFeedback[]
  productLaunches                   ProductLaunch[]
  productOpportunities              ProductOpportunity[]
  productResearchCandidateDecisions ProductResearchCandidateDecision[]
  researchReports                   ProductResearchReport[]
  productResearchRuns               ProductResearchRun[]
  productResearchSourceHealth       ProductResearchSourceHealth[]
  productRiskRecords                ProductRiskRecord[]
  productScores                     ProductScore[]
  productSignals                    ProductSignal[]
  profitCalcs                       ProfitCalculation[]
  promptTemplates                   PromptTemplate[]
  promptVersions                    PromptVersion[]
  replenishmentPlans                ReplenishmentPlan[]
  researchReportArtifacts           ResearchReportArtifact[]
  reviewTasks                       ReviewTask[]
  routerDecisionLogs                RouterDecisionLog[]
  scoringVersions                   ScoringVersion[]
  sops                              Sop[]
  suppliers                         Supplier[]
  supplySkus                        SupplySku[]
  tasks                             TeamTask[]
  trainingJobs                      TrainingJob[]
  trendInsights                     TrendInsight[]
  workspaces                        Workspace[]

  @@index([plan])
  @@index([slug])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("memberships")
}

model Workspace {
  id                                String                             @id @default(cuid())
  organizationId                    String
  name                              String
  channelType                       ChannelType
  marketplace                       String?
  currency                          String                             @default("USD")
  timezone                          String                             @default("Asia/Shanghai")
  status                            String                             @default("ACTIVE")
  createdAt                         DateTime                           @default(now())
  agentCapabilityTokens             AgentCapabilityToken[]
  agentExperienceCards              AgentExperienceCard[]
  agentRuns                         AgentRun[]
  agentWorkMemories                 AgentWorkMemory[]
  alerts                            Alert[]
  sessions                          AssistantSession[]
  automationFlows                   AutomationFlow[]
  businessOutcomes                  BusinessOutcome[]
  channelConns                      ChannelConnection[]
  fileAssets                        FileAsset[]
  imageProjects                     ImagePromptProject[]
  keywordReports                    KeywordReport[]
  knowledgeDocs                     KnowledgeDocument[]
  listingDrafts                     ListingDraft[]
  marketObservationBatches          MarketObservationBatch[]
  marketplaceOrders                 MarketplaceOrder[]
  mcpToolInvocations                McpToolInvocation[]
  productCandidates                 ProductCandidate[]
  productFeedback                   ProductFeedback[]
  productOpportunities              ProductOpportunity[]
  productResearchCandidateDecisions ProductResearchCandidateDecision[]
  researchReports                   ProductResearchReport[]
  productResearchRuns               ProductResearchRun[]
  productResearchSourceHealth       ProductResearchSourceHealth[]
  productRiskRecords                ProductRiskRecord[]
  productScores                     ProductScore[]
  productSignals                    ProductSignal[]
  products                          Product[]
  profitCalcs                       ProfitCalculation[]
  replenishmentPlans                ReplenishmentPlan[]
  researchReportArtifacts           ResearchReportArtifact[]
  scoringVersions                   ScoringVersion[]
  storeAgentProfile                 StoreAgentProfile?
  storeMetrics                      StoreMetricSnapshot[]
  suppliers                         Supplier[]
  supplySkus                        SupplySku[]
  tasks                             TeamTask[]
  trendInsights                     TrendInsight[]
  organization                      Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([channelType])
  @@index([status])
  @@map("workspaces")
}

model ChannelConnection {
  id                    String             @id @default(cuid())
  workspaceId           String
  provider              String
  externalShopId        String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  syncStatus            ChannelSyncStatus  @default(PENDING)
  lastSyncedAt          DateTime?
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders                MarketplaceOrder[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider])
  @@index([syncStatus])
  @@index([workspaceId, provider, syncStatus], map: "idx_channel_connections_ws_provider_status")
  @@map("channel_connections")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id               String               @id @default(cuid())
  workspaceId      String
  title            String
  sku              String?
  asinOrExternalId String?
  images           String[]
  cost             Decimal              @default(0)
  price            Decimal              @default(0)
  currency         String               @default("USD")
  status           ProductStatus        @default(DRAFT)
  metadata         Json                 @default("{}")
  createdAt        DateTime             @default(now())
  imageProjects    ImagePromptProject[]
  listingDrafts    ListingDraft[]
  productLaunches  ProductLaunch[]
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profitCalcs      ProfitCalculation[]
  supplySkus       SupplySku[]

  @@index([workspaceId])
  @@index([sku])
  @@index([asinOrExternalId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_products_ws_status_created")
  @@map("products")
}

model FileAsset {
  id                      String               @id @default(cuid())
  organizationId          String
  workspaceId             String?
  ownerId                 String
  filename                String
  mimeType                String
  size                    Int
  storageKey              String
  publicUrl               String?
  purpose                 FilePurpose
  createdAt               DateTime             @default(now())
  sha256                  String?
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace               Workspace?           @relation(fields: [workspaceId], references: [id])
  imageProjectReferences  ImagePromptProject[] @relation("ImageProjectReferenceAsset")
  productLaunchReferences ProductLaunch[]      @relation("ProductLaunchReferenceAsset")

  @@index([organizationId])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([purpose])
  @@map("file_assets")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model KnowledgeDocument {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String?
  title          String
  content        String
  fileAssetId    String?
  tags           String[]           @default([])
  visibility     DocumentVisibility @default(ORGANIZATION)
  createdBy      String
  createdAt      DateTime           @default(now())
  creator        User               @relation("DocCreator", fields: [createdBy], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?         @relation(fields: [workspaceId], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdBy])
  @@index([visibility])
  @@index([title])
  @@index([organizationId, visibility, createdBy, createdAt(sort: Desc)], map: "idx_knowledge_docs_org_vis_creator")
  @@map("knowledge_documents")
}

model Sop {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         SopStatus    @default(DRAFT)
  steps          Json         @default("[]")
  createdBy      String
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  creator        User         @relation(fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
  @@map("sops")
}

model TeamTask {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String?
  title          String
  description    String?
  assigneeId     String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  dueAt          DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User         @relation("TaskCreator", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([createdBy])
  @@index([status])
  @@index([priority])
  @@index([organizationId, status, createdAt(sort: Desc)], map: "idx_team_tasks_org_status_created")
  @@map("team_tasks")
}

model PromptTemplate {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  category       String
  content        String
  variables      Json         @default("[]")
  usageCount     Int          @default(0)
  createdBy      String
  createdAt      DateTime     @default(now())
  creator        User         @relation(fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@index([createdBy])
  @@map("prompt_templates")
}

model AssistantSession {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String?
  userId         String
  title          String
  contextType    SessionContextType @default(GENERAL)
  status         SessionStatus      @default(ACTIVE)
  createdAt      DateTime           @default(now())
  allowedDomains String[]           @default([])
  autonomyLevel  Int                @default(1)
  context        Json               @default("{}")
  updatedAt      DateTime           @updatedAt
  plans          AgentPlan[]
  messages       AssistantMessage[]
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id])
  workspace      Workspace?         @relation(fields: [workspaceId], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([contextType])
  @@index([status])
  @@map("assistant_sessions")
}

model AgentAutonomyPolicy {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String?
  scopeKey         String
  level            Int          @default(1)
  allowedTools     String[]     @default([])
  deniedTools      String[]     @default([])
  highRiskApproval Boolean      @default(true)
  createdBy        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeKey])
  @@index([organizationId, userId])
  @@map("agent_autonomy_policies")
}

model AgentPlan {
  id             String               @id @default(cuid())
  conversationId String
  organizationId String
  goal           String
  status         String               @default("PLANNED")
  plan           Json
  result         Json?
  error          Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   AssistantSession     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     AgentToolExecution[]

  @@index([organizationId, status])
  @@index([conversationId, createdAt])
  @@map("agent_plans")
}

model AgentToolExecution {
  id             String       @id @default(cuid())
  organizationId String
  planId         String
  toolName       String
  toolVersion    String
  status         String       @default("PLANNED")
  riskLevel      String
  idempotencyKey String
  inputHash      String
  input          Json
  output         Json?
  error          Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           AgentPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([planId])
  @@map("agent_tool_executions")
}

model MarketObservationBatch {
  id               String                  @id @default(cuid())
  organizationId   String
  userId           String
  workspaceId      String?
  source           String
  pageType         String
  pageUrl          String
  query            String?
  category         String?
  capturedAt       DateTime
  locale           String?
  pageTitle        String?
  pageFingerprint  String
  parserVersion    String
  extensionVersion String?
  rawEvidence      Json
  confidence       Float
  requiresReview   Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?              @relation(fields: [workspaceId], references: [id])
  items            MarketObservationItem[]

  @@unique([organizationId, pageFingerprint, capturedAt], map: "market_observation_batches_org_fingerprint_captured_key")
  @@index([organizationId, capturedAt])
  @@index([workspaceId])
  @@map("market_observation_batches")
}

model MarketObservationItem {
  id                 String                 @id @default(cuid())
  organizationId     String
  batchId            String
  externalId         String?
  offerId            String?
  title              String
  url                String
  imageUrl           String?
  brand              String?
  category           String?
  sellerName         String?
  currentPrice       Decimal?
  originalPrice      Decimal?
  currency           String?
  rating             Float?
  reviewCount        Int?
  displayedSalesText String?
  position           Int?
  badges             Json                   @default("[]")
  deliveryText       String?
  promotionText      String?
  sponsored          Boolean?
  rawEvidence        Json
  evidenceHash       String
  createdAt          DateTime               @default(now())
  batch              MarketObservationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities      ProductOpportunity[]

  @@index([organizationId, externalId])
  @@index([organizationId, url])
  @@index([batchId, position])
  @@map("market_observation_items")
}

model ProductOpportunity {
  id                 String                @id @default(cuid())
  organizationId     String
  workspaceId        String?
  observationItemId  String
  title              String
  externalId         String?
  sourceUrl          String
  status             String                @default("CANDIDATE")
  score              Float?
  decision           String?
  dimensions         Json
  reasons            Json
  risks              Json
  missingEvidence    Json
  sources            Json
  scoringVersion     String
  evidenceConfidence Float
  createdBy          String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  outcomes           BusinessOutcome[]
  creator            User                  @relation(fields: [createdBy], references: [id])
  observationItem    MarketObservationItem @relation(fields: [observationItemId], references: [id], onDelete: Cascade)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          Workspace?            @relation(fields: [workspaceId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([observationItemId, scoringVersion])
  @@map("product_opportunities")
}

model BusinessOutcome {
  id                String              @id @default(cuid())
  organizationId    String
  workspaceId       String?
  productId         String?
  opportunityId     String?
  listingDraftId    String?
  publishSnapshotId String?
  source            String
  periodStart       DateTime
  periodEnd         DateTime
  metrics           Json
  evidence          Json
  confidence        Float
  createdAt         DateTime            @default(now())
  agentRunId        String?
  externalReference String?
  opportunity       ProductOpportunity? @relation(fields: [opportunityId], references: [id])
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace         Workspace?          @relation(fields: [workspaceId], references: [id])

  @@unique([organizationId, source, externalReference])
  @@index([organizationId, productId])
  @@index([organizationId, periodEnd])
  @@index([opportunityId])
  @@index([agentRunId])
  @@map("business_outcomes")
}

model FeedbackSignal {
  id                String       @id @default(cuid())
  organizationId    String
  runId             String?
  approvalId        String?
  listingId         String?
  snapshotId        String?
  promptVersion     String?
  modelVersion      String?
  agentType         AgentType?
  signalType        String
  source            String
  externalReference String
  value             Json
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run               AgentRun?    @relation(fields: [runId], references: [id])

  @@unique([organizationId, source, externalReference, signalType], map: "feedback_signals_org_source_reference_type_key")
  @@index([approvalId], map: "feedback_signals_approval_idx")
  @@index([listingId], map: "feedback_signals_listing_idx")
  @@index([organizationId, signalType, createdAt], map: "feedback_signals_org_type_created_idx")
  @@index([runId, createdAt], map: "feedback_signals_run_created_idx")
  @@index([snapshotId], map: "feedback_signals_snapshot_idx")
  @@map("feedback_signals")
}

model AgentEvalSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  agentType      AgentType
  windowStart    DateTime
  windowEnd      DateTime
  scores         Json
  sampleSize     Int
  coverage       Float
  version        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentType, windowStart, windowEnd, version], map: "agent_eval_snapshots_org_agent_window_version_key")
  @@index([organizationId, agentType, windowEnd], map: "agent_eval_snapshots_org_agent_window_idx")
  @@map("agent_eval_snapshots")
}

model PromptVersion {
  id             String              @id @default(cuid())
  organizationId String
  agentType      AgentType
  version        String
  templateRef    String
  contentHash    String
  routingWeight  Float               @default(0)
  status         PromptVersionStatus @default(DRAFT)
  metadata       Json                @default("{}")
  createdBy      String
  createdAt      DateTime            @default(now())
  activatedAt    DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentType, version], map: "prompt_versions_org_agent_version_key")
  @@index([contentHash])
  @@index([organizationId, agentType, status], map: "prompt_versions_org_agent_status_idx")
  @@map("prompt_versions")
}

model RouterDecisionLog {
  id                    String       @id @default(cuid())
  organizationId        String
  runId                 String
  decisionKey           String
  agentType             AgentType
  selectedModel         String
  selectedPromptVersion String?
  reason                Json
  latencyMs             Int?
  costAmount            Decimal?
  qualityScore          Float?
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run                   AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([organizationId, decisionKey], map: "router_decision_logs_org_decisionKey_key")
  @@index([organizationId, agentType, createdAt], map: "router_decision_logs_org_agent_created_idx")
  @@index([runId], map: "router_decision_logs_run_idx")
  @@map("router_decision_logs")
}

model TrainingJob {
  id             String            @id @default(cuid())
  organizationId String
  agentType      AgentType
  status         TrainingJobStatus @default(DRAFT)
  datasetRef     String
  inputHash      String
