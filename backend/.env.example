# ============================
# ShopMate AI Backend - Environment Variables
# ============================

# ---- App ----
NODE_ENV=development
PORT=3000

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/shopmate?schema=public
DATABASE_ADMIN_URL=postgresql://migration-admin:password@localhost:5432/shopmate?schema=public
# 生产环境请使用托管 PostgreSQL，并在发布流程中执行 `pnpm db:migrate:deploy`
# 备份/恢复演练：`pnpm db:backup` / `pnpm db:restore`

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# ---- Email ----
# console = 打印到日志（开发用）；smtp = 真实发信
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ShopMate <no-reply@example.com>

JWT_2FA_TEMP_SECRET=
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# 连续失败达到阈值后临时锁定账号，并向账号邮箱发送安全提醒
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---- CORS ----
CORS_ORIGINS=*

# ---- AI Agent（电商设计图一致性智能体对接）----
# 两个都配置后自动切换到 HttpAgentProvider（否则用 Mock 假数据）。
# AGENT_BASE_URL 是后端访问智能体的地址；AGENT_API_KEY 需与智能体
# agent/.env 中的 AGENT_API_KEY 一致。
AGENT_BASE_URL=http://localhost:8080
AGENT_API_KEY=please-change-to-a-shared-secret
# Mock responses are development/test only. Production validation requires false.
AGENT_ALLOW_MOCK=true
# 可选：浏览器加载生成图片用的地址（默认同 AGENT_BASE_URL）
# AGENT_PUBLIC_URL=http://localhost:8080
# 智能体→平台事件回调共享密钥（与 agent/.env 的 AGENT_WEBHOOK_SECRET 一致，≥16位）
# AGENT_WEBHOOK_SECRET=please-change-me-min-16-chars
# Consistency review threshold. Must be calibrated with labeled samples before production changes.
AGENT_REVIEW_THRESHOLD=60
# Local stdio MCP bridge for the commerce image/listing agent.
# Defaults to ../电商设计图保持产品一致性智能体/agent/mcp_server.py from the backend cwd.
# COMMERCE_AGENT_MCP_SERVER=G:/平台/电商设计图保持产品一致性智能体/agent/mcp_server.py
COMMERCE_AGENT_PYTHON=python
COMMERCE_AGENT_MCP_TIMEOUT_MS=30000

# ---- Marketplace APIs ----
# Ozon Seller API base URL. Seller credentials are stored per channel connection.
OZON_API_BASE_URL=https://api-seller.ozon.ru
# 已连接 Ozon 渠道的只读订单轮询间隔。设为 0 可关闭后台自动拉单。
OZON_ORDER_SYNC_INTERVAL_MS=300000
# 已被 Ozon 确认接收但尚未激活的商品，只读回查间隔与过期阈值。
PRODUCT_LAUNCH_RECOVERY_INTERVAL_MS=60000
PRODUCT_LAUNCH_RECOVERY_STALE_AFTER_MS=300000

# ---- Daily evidence-first product research ----
# Keep DRY_RUN until a reviewed SHADOW/PILOT rollout has evidence and an owner.
DAILY_PRODUCT_RESEARCH_MODE=DRY_RUN
DAILY_PRODUCT_RESEARCH_TIMEZONE=Asia/Shanghai
DAILY_PRODUCT_RESEARCH_CANDIDATE_LIMIT=300
DAILY_PRODUCT_RESEARCH_TOP_LIMIT=10
DAILY_PRODUCT_RESEARCH_PILOT_ORGANIZATION_IDS=
DAILY_PRODUCT_RESEARCH_REAL_CONNECTORS_ENABLED=false
DAILY_PRODUCT_RESEARCH_INTERNAL_ACTIONS_ENABLED=false
DAILY_PRODUCT_RESEARCH_GENERAL_ACCESS_ENABLED=false
SUPPLIER_IMAGE_SEARCH_ENRICHMENT_ENABLED=false
SUPPLIER_IMAGE_SEARCH_ENRICHMENT_LIMIT=10

# ---- Storage ----
STORAGE_PROVIDER=local
# S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=shopmate-uploads
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# ---- Immutable audit archive (S3 Object Lock / WORM) ----
# Production requires a separate versioned bucket created with Object Lock enabled.
AUDIT_ARCHIVE_ENABLED=false
# AUDIT_ARCHIVE_S3_BUCKET=shopmate-audit-worm
# AUDIT_ARCHIVE_S3_REGION=us-east-1
# AUDIT_ARCHIVE_S3_ENDPOINT=https://s3.amazonaws.com
# Leave credentials empty when the runtime uses an IAM role.
# AUDIT_ARCHIVE_S3_ACCESS_KEY_ID=
# AUDIT_ARCHIVE_S3_SECRET_ACCESS_KEY=
AUDIT_ARCHIVE_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_ARCHIVE_RETENTION_DAYS=2555
# Required in production for SSE-KMS encryption.
# AUDIT_ARCHIVE_KMS_KEY_ID=alias/shopmate-audit

# ---- Encryption ----
# Production must use AWS KMS envelope encryption. Prefer an IAM role over
# static AWS credentials. Local mode remains available for development only.
CREDENTIAL_ENCRYPTION_PROVIDER=local
# KMS_KEY_ID=alias/shopmate-credentials
# KMS_REGION=us-east-1
# KMS_ENDPOINT=https://kms.us-east-1.amazonaws.com
# KMS_ACCESS_KEY_ID=
# KMS_SECRET_ACCESS_KEY=
# Preferred rotation-ready keyring. Keep retired keys here until rotation finishes.
# ENCRYPTION_ACTIVE_KEY_ID=key-2026-07
# ENCRYPTION_KEYS={"key-2026-07":"replace-with-32-plus-char-secret","key-previous":"replace-with-previous-secret"}
# Legacy single key (supported for migration; new deployments should use the keyring above).
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---- Billing / Stripe ----
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# STRIPE_PRICE_FREE=price_free
# STRIPE_PRICE_STARTER=price_starter
# STRIPE_PRICE_PROFESSIONAL=price_pro
# STRIPE_PRICE_ENTERPRISE=price_enterprise
FRONTEND_URL=http://localhost:5173

# ---- Enterprise release evidence ----
# One or two real pilot organization IDs, comma-separated.
# ENTERPRISE_PILOT_ORGANIZATION_IDS=
# A real external penetration-test report issued within the last 90 days.
# PENTEST_REPORT_PATH=C:/secure-evidence/pentest-report.pdf
# PENTEST_REPORT_SHA256=
# PENTEST_COMPLETED_AT=2026-07-01T00:00:00.000Z
# PENTEST_PROVIDER=
PENTEST_UNRESOLVED_CRITICAL=0
PENTEST_UNRESOLVED_HIGH=0
# A sanitized JSON receipt from a successful Stripe live-mode payment/refund test.
# STRIPE_LIVE_E2E_RECEIPT_PATH=C:/secure-evidence/stripe-live-e2e.json

# ---- Logging ----
LOG_LEVEL=info
