{
  "manifest_version": 3,
  "name": "ShopMate Ozon 公开证据采集器",
  "version": "1.0.0",
  "description": "由用户主动采集当前可见的 Ozon 公开商品证据，并在确认后提交到本地 ShopMate。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://ozon.ru/*",
    "https://*.ozon.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "采集当前 Ozon 页面",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://ozon.ru/*", "https://*.ozon.ru/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
