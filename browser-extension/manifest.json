{
  "manifest_version": 3,
  "name": "ShopMate Ozon Public Evidence Collector",
  "version": "1.0.0",
  "description": "User-triggered collection of visible public Ozon product evidence for confirmed submission to local ShopMate.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://ozon.ru/*",
    "https://*.ozon.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Capture current Ozon page",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://ozon.ru/*",
        "https://*.ozon.ru/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
