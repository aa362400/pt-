{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.1.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "title": "ShopMate AI — Service Overview",
  "tags": ["shopmate", "ai", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "collapsed": false,
      "title": "Service Health",
      "panels": [
        {
          "id": 1,
          "title": "QPS",
          "description": "Requests per second measured across all endpoints",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "rate(http_requests_total[1m])",
              "legendFormat": "QPS",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 80 },
                  { "color": "red", "value": 150 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 2,
          "title": "Error Rate",
          "description": "Percentage of HTTP 5xx responses relative to total requests",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "rate(http_requests_total{status=~\"5..\"}[1m]) / rate(http_requests_total[1m]) * 100",
              "legendFormat": "Error %",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 1 },
                  { "color": "red", "value": 5 }
                ]
              },
              "min": 0,
              "max": 100
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 3,
          "title": "P95 / P99 Latency",
          "description": "HTTP request duration at the 95th and 99th percentiles",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "P95",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
              "legendFormat": "P99",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.3 },
                  { "color": "red", "value": 0.5 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 4,
          "title": "Active Users",
          "description": "Distinct active user sessions in the last 5 minutes",
          "type": "stat",
          "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "count(count by(user_id) (rate(http_requests_total[5m])))",
              "legendFormat": "Active Users",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 50 },
                  { "color": "red", "value": 100 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
        }
      ]
    },
    {
      "collapsed": false,
      "title": "Business Metrics",
      "panels": [
        {
          "id": 5,
          "title": "Agent Run Success Rate",
          "description": "Fraction of agent runs completing without error",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "rate(agent_runs_total{status='success'}[5m]) / rate(agent_runs_total[5m]) * 100",
              "legendFormat": "Success %",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 90 },
                  { "color": "red", "value": 80 }
                ]
              },
              "min": 0,
              "max": 100
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 6,
          "title": "Queue Depth",
          "description": "Number of pending jobs across each queue",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "bullmq_jobs_waiting{queue='agent-runs'}",
              "legendFormat": "agent-runs",
              "refId": "A"
            },
            {
              "expr": "bullmq_jobs_waiting{queue='automation'}",
              "legendFormat": "automation",
              "refId": "B"
            },
            {
              "expr": "bullmq_jobs_waiting{queue='exports'}",
              "legendFormat": "exports",
              "refId": "C"
            },
            {
              "expr": "bullmq_jobs_waiting{queue='notifications'}",
              "legendFormat": "notifications",
              "refId": "D"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 20 },
                  { "color": "red", "value": 50 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 7,
          "title": "Concurrent Job Processing",
          "description": "Number of jobs currently being processed by BullMQ workers",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "sum(bullmq_jobs_active)",
              "legendFormat": "Active jobs",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 10 },
                  { "color": "red", "value": 20 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        }
      ]
    },
    {
      "collapsed": false,
      "title": "Infrastructure",
      "panels": [
        {
          "id": 8,
          "title": "PostgreSQL Connections",
          "description": "Active and idle database connections",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 0, "y": 2 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "pg_stat_activity_count{state='active'}",
              "legendFormat": "Active",
              "refId": "A"
            },
            {
              "expr": "pg_stat_activity_count{state='idle'}",
              "legendFormat": "Idle",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 20 },
                  { "color": "red", "value": 40 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 9,
          "title": "Redis Memory Usage",
          "description": "Memory consumed by the Redis data store",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 6, "y": 2 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "redis_memory_used_bytes",
              "legendFormat": "Used",
              "refId": "A"
            },
            {
              "expr": "redis_memory_max_bytes",
              "legendFormat": "Max",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 1073741824 },
                  { "color": "red", "value": 2147483648 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 10,
          "title": "Node.js Heap Usage",
          "description": "V8 heap memory used vs. allocated",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 2 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "nodejs_heap_size_used_bytes",
              "legendFormat": "Heap Used",
              "refId": "A"
            },
            {
              "expr": "nodejs_heap_size_total_bytes",
              "legendFormat": "Heap Total",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 268435456 },
                  { "color": "red", "value": 536870912 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        },
        {
          "id": 11,
          "title": "Event Loop Lag",
          "description": "Node.js event loop maximum delay indicating blocking operations",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 6, "x": 18, "y": 2 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "nodejs_event_loop_lag_seconds",
              "legendFormat": "Lag",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.05 },
                  { "color": "red", "value": 0.1 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        }
      ]
    },
    {
      "collapsed": false,
      "title": "Per-Endpoint",
      "panels": [
        {
          "id": 12,
          "title": "Top 5 Slowest Endpoints",
          "description": "Endpoints with the highest P50 latency over the last 15 minutes",
          "type": "table",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 3 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "topk(5, histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[15m])) by (le, route)))",
              "legendFormat": "__auto",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.3 },
                  { "color": "red", "value": 0.5 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "footer": { "show": false }, "sortBy": [{ "desc": true, "displayName": "Value" }] }
        },
        {
          "id": 13,
          "title": "Top 5 Most-Called Endpoints",
          "description": "Routes receiving the highest request volume in the last 15 minutes",
          "type": "table",
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 3 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "topk(5, sum(rate(http_requests_total[15m])) by (route))",
              "legendFormat": "__auto",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 10 },
                  { "color": "red", "value": 50 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "footer": { "show": false }, "sortBy": [{ "desc": true, "displayName": "Value" }] }
        },
        {
          "id": 14,
          "title": "Error Breakdown by Status Code",
          "description": "Rate of 4xx and 5xx responses broken down by HTTP status code",
          "type": "barchart",
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 3 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            {
              "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m])) by (status)",
              "legendFormat": "{{ status }}",
              "refId": "A"
            },
            {
              "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (status)",
              "legendFormat": "{{ status }}",
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 1 },
                  { "color": "red", "value": 5 }
                ]
              },
              "min": 0
            },
            "overrides": []
          },
          "options": { "orientation": "auto", "groupWidth": 0.7, "showValue": "auto", "legend": { "displayMode": "list", "placement": "bottom" } }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "type": "dashboard",
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "limit": 100,
        "showIn": 0,
        "tags": ["deploy", "release"],
        "target": { "limit": 100, "matchAny": false, "tags": ["deploy", "release"], "type": "tags" }
      }
    ]
  }
}
