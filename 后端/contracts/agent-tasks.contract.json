{
  "$comment": "ShopMate 平台 ↔ Python 智能体任务契约（三处镜像，契约测试保证同步）。修改任何 taskType 的输入/输出字段时必须同时更新三份文件并升 contractVersion。",
  "contractVersion": "1.6.2",
  "transport": {
    "createRun": {
      "method": "POST",
      "path": "/api/v1/agent/runs",
      "auth": "X-Api-Key",
      "request": {
        "taskType": "string",
        "input": "object",
        "context": "object?"
      },
      "response": {
        "runId": "string",
        "sessionId": "string",
        "status": "string",
        "traceId": "string(w3c-32hex)"
      }
    },
    "getRun": {
      "method": "GET",
      "path": "/api/v1/agent/runs/{runId}",
      "response": {
        "runId": "string",
        "taskType": "string",
        "status": "queued|running|completed|failed",
        "progress": { "stage": "string?", "message": "string?" },
        "result": "object|null",
        "error": "string",
        "diagnostics": {
          "$type": "object|null",
          "code": "string(1-128)?",
          "taskType": "string(1-128)?",
          "issues": "string[]?",
          "suggestions": "string[]?",
          "evidence": "object?"
        },
        "context": "object"
      }
    },
    "eventCallback": {
      "$comment": "智能体 → 平台的进度/完成事件推送（阶段2）",
      "method": "POST",
      "path": "{PLATFORM_CALLBACK_URL}/api/v1/agent-runs/{agentRunId}/events",
      "auth": "X-Agent-Signature: HMAC-SHA256(body, AGENT_WEBHOOK_SECRET)",
      "request": {
        "runId": "string",
        "status": "running|completed|failed",
        "stage": "string?",
        "message": "string?",
        "timestamp": "ISO8601"
      }
    },
    "context": {
      "$comment": "身份贯通字段（阶段4），平台创建任务时放入顶层 context，智能体原样回显在结果 _context 中",
      "orgId": "string",
      "userId": "string",
      "workspaceId": "string?",
      "requestId": "string?",
      "agentRunId": "string?",
      "locale": "string?",
      "traceId": "string(w3c-32hex)?",
      "traceparent": "string(w3c-traceparent)?"
    }
  },
  "tasks": {
    "generate_images": {
      "input": {
        "required": [],
        "oneOfRequired": ["imageBase64", "imageUrl"],
        "properties": {
          "productName": "string",
          "imageBase64": "string(base64|dataURL)",
          "imageUrl": "string(url)",
          "sceneCount": "number(1-9)",
          "platforms": "string[]",
          "message": "string"
        }
      },
      "output": {
        "required": [
          "sessionId",
          "mockMode",
          "supervisionApproved",
          "publishable",
          "images"
        ],
        "properties": {
          "sessionId": "string",
          "mockMode": "boolean",
          "supervisionApproved": "boolean",
          "publishable": "boolean",
          "images": [
            {
              "sceneId": "string",
              "filename": "string",
              "url": "string",
              "background": "string?",
              "props": "string[]?",
              "lighting": "string?",
              "emotion": "string?",
              "composition": "string?",
              "prompt": "string?"
            }
          ],
          "consistencyScore": "number|null",
          "profile": "object|null",
          "scenePlan": "array?",
          "downloadUrl": "string?"
        }
      }
    },
    "analyze_product": {
      "input": {
        "required": [],
        "oneOfRequired": ["imageBase64", "imageUrl"],
        "properties": { "imageBase64": "string", "imageUrl": "string" }
      },
      "output": {
        "required": ["sessionId", "profile"],
        "properties": {
          "sessionId": "string",
          "profile": "object",
          "scenePlan": "array"
        }
      }
    },
    "supplier_image_search": {
      "input": {
        "required": [],
        "oneOfRequired": ["imageBase64", "imageUrl"],
        "properties": {
          "imageBase64": "string(base64|dataURL)",
          "imageUrl": "string(https-url)",
          "imageKeywords": "string(trimmed,1-200)?"
        }
      },
      "output": {
        "required": [
          "outcome",
          "providerResultCount",
          "offers",
          "imageEvidence",
          "provenance"
        ],
        "properties": {
          "outcome": "MATCHES|NO_RESULTS",
          "providerResultCount": "number",
          "offers": [
            {
              "offerId": "string",
              "subject": "string|null",
              "detailUrl": "string|null",
              "imageUrl": "string|null",
              "distributionFreePostage": "boolean|null",
              "displayPriceEvidence": {
                "price": "string|null",
                "consignPrice": "string|null",
                "multipleConsignPrice": "string|null",
                "evidenceUse": "DISPLAY_ONLY",
                "verifiedProcurementCost": false
              }
            }
          ],
          "imageEvidence": {
            "canonicalizationVersion": "supplier-image-search-payload/v2",
            "sourceOriginalSha256": "string(sha256)",
            "sourceCanonicalSha256": "string(sha256)",
            "decodedSizeBytes": "number(1-3145728)",
            "payloadMimeType": "image/png",
            "width": "number",
            "height": "number",
            "retrievalHashAlgorithm": "DHASH64",
            "retrievalHash": "string",
            "retrievalOnly": true
          },
          "provenance": {
            "adapterVersion": "supplier-image-search-adapter/v1",
            "provider": "string(non-secret-config-id)",
            "requestId": "string(platform-precommitted)",
            "fetchedAt": "ISO8601(UTC)",
            "rawSnapshotSha256": "string(sha256)"
          }
        }
      }
    },
    "global_product_discovery": {
      "input": {
        "required": ["businessDate", "candidateLimit"],
        "properties": {
          "businessDate": "string(YYYY-MM-DD)",
          "candidateLimit": "number(1-300)",
          "seedQueries": "string[]?"
        }
      },
      "output": {
        "required": ["candidates", "provider", "fetchedAt", "methodology"],
        "properties": {
          "candidates": "externalCandidate[]",
          "provider": "string",
          "fetchedAt": "ISO8601",
          "conceptCount": "number",
          "searchAttempts": "number",
          "searchSuccesses": "number",
          "searchFailures": "array",
          "methodology": "object"
        }
      }
    },
    "product_research": {
      "input": {
        "required": ["productName"],
        "properties": {
          "productName": "string",
          "marketplace": "string",
          "locale": "string?"
        }
      },
      "output": {
        "required": ["summary", "competitors", "priceRange", "rating"],
        "properties": {
          "summary": "string",
          "competitors": "string[]",
          "priceRange": { "min": "number", "max": "number" },
          "rating": "number(1-5)",
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "assistant_chat": {
      "input": {
        "required": ["prompt"],
        "properties": {
          "assistantId": "string",
          "threadId": "string?",
          "prompt": "string",
          "workspaceId": "string?"
        }
      },
      "output": {
        "required": ["response"],
        "properties": {
          "response": "string",
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "listing_generation": {
      "input": {
        "required": ["productName"],
        "properties": {
          "productName": "string",
          "description": "string?",
          "keywords": "string[]",
          "platform": "amazon|shopify|etsy|ebay",
          "tone": "string?"
        }
      },
      "output": {
        "required": ["title", "description", "bulletPoints", "keywords"],
        "properties": {
          "title": "string",
          "description": "string",
          "bulletPoints": "string[]",
          "keywords": "string[]",
          "price": "number|null",
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "keyword_analysis": {
      "input": {
        "required": ["seedKeywords"],
        "properties": {
          "seedKeywords": "string[]",
          "marketplace": "string",
          "locale": "string?"
        }
      },
      "output": {
        "required": ["keywords"],
        "properties": {
          "keywords": [
            {
              "keyword": "string",
              "volume": "number",
              "difficulty": "number(0-100)"
            }
          ],
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "trend_analysis": {
      "input": {
        "required": ["category"],
        "properties": {
          "category": "string",
          "marketplace": "string",
          "timeframe": "string?"
        }
      },
      "output": {
        "required": ["trends"],
        "properties": {
          "trends": [
            { "name": "string", "growth": "number", "seasonality": "string" }
          ],
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "image_prompt": {
      "input": {
        "required": ["productName"],
        "properties": {
          "productName": "string",
          "description": "string?",
          "style": "string?",
          "platform": "string?"
        }
      },
      "output": {
        "required": ["prompt"],
        "properties": {
          "prompt": "string",
          "negativePrompt": "string?",
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "automation_step": {
      "input": {
        "required": ["stepType"],
        "properties": {
          "stepType": "string",
          "params": "object",
          "context": "object"
        }
      },
      "output": {
        "required": ["executed", "stepType"],
        "properties": {
          "executed": "boolean",
          "stepType": "string",
          "result": "object",
          "note": "string?",
          "qualityScore": "number|null?",
          "qualityRationale": "string?"
        }
      }
    },
    "plan_and_execute": {
      "input": {
        "required": ["goal"],
        "properties": {
          "goal": "string",
          "context": "object?"
        }
      },
      "output": {
        "required": ["status", "results"],
        "properties": {
          "status": "string",
          "total_steps": "number",
          "completed_steps": "number",
          "failed_steps": "number",
          "results": "array",
          "final_context": "object"
        }
      }
    }
  }
}
