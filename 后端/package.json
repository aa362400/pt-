{
  "name": "智能体后端",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:release": "eslint \"src/shared/commerce-mcp/**/*.ts\" \"src/features/agent-memory/**/*.ts\" \"src/features/enterprise-slo/judge-calibration-evidence.ts\" \"src/cli/verify-enterprise-readiness.ts\" \"test/commerce-mcp-trust.service.spec.ts\" \"test/agent-memory-governance.spec.ts\" \"test/enterprise-readiness-evidence.spec.ts\" \"test/judge-calibration-evidence.spec.ts\"",
    "test": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --config ./test/jest-e2e.json --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:release": "jest --config ./test/jest-e2e.json --runInBand",
    "release:verify": "npm run db:migrations:verify && npm run build && npm run lint:release && npx prisma validate && npm run test:release",
    "db:seed": "ts-node --compilerOptions \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" prisma/seed.ts",
    "db:migrate:deploy": "node scripts/migrations/deploy-guarded.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrations:verify": "node scripts/migrations/verify-migration-governance.mjs",
    "db:migrations:drift:check": "node scripts/migrations/verify-database-drift.mjs",
    "db:migrations:baseline:resolve": "node scripts/migrations/resolve-baseline.mjs",
    "db:migrations:failures": "node scripts/migrations/report-failed-migrations.mjs",
    "db:app-role:bootstrap": "node dist/cli/bootstrap-database-app-role.js",
    "db:backup": "bash ./scripts/db-backup.sh",
    "db:restore": "bash ./scripts/db-restore.sh",
    "acceptance:ozon-readonly": "node dist/cli/ozon-readonly-regression.js",
    "acceptance:agent-nonmock": "node dist/cli/agent-nonmock-regression.js",
    "credentials:bootstrap-local-key": "node dist/cli/bootstrap-local-encryption-key.js",
    "credentials:rotate:ozon": "node dist/cli/rotate-ozon-credentials.js",
    "security:rls:verify": "node dist/cli/verify-rls.js",
    "security:rls:channel-acceptance": "node dist/cli/verify-channel-rls.js",
    "enterprise:readiness:verify": "node dist/cli/verify-enterprise-readiness.js",
    "mcp:trust:sign": "node dist/cli/sign-commerce-mcp-trust.js",
    "memory:governance:backfill": "node dist/cli/backfill-memory-governance.js",
    "agent-errors:backfill": "node dist/cli/backfill-agent-run-error-codes.js",
    "load:api:run-create": "k6 run ../tests/load/load_api_run_create.js",
    "load:approval": "k6 run ../tests/load/load_approval_flow.js",
    "load:async:dry": "python ../tests/load/load_async_pipeline.py --dry-run"
  },
  "prisma": {
    "seed": "ts-node --compilerOptions \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1079.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@prisma/client": "^6.19.3",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "linkfoxskill": "0.1.13",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.3",
    "stripe": "^22.3.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
