# Copy to .env.local-server by running scripts/local-server/setup.ps1.
LOCAL_SERVER_BIND_ADDRESS=0.0.0.0
LOCAL_SERVER_PORT=80

POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=shopmate_codex
POSTGRES_APP_USER=shopmate_app
POSTGRES_APP_PASSWORD=__GENERATE__

JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_2FA_TEMP_SECRET=__GENERATE__
AGENT_API_KEY=__GENERATE__
AGENT_WEBHOOK_SECRET=__GENERATE__

ENCRYPTION_ACTIVE_KEY_ID=local-server-v1
ENCRYPTION_KEYS=__GENERATE_KEYRING__
SEED_ADMIN_PASSWORD=__GENERATE_PASSWORD__

CORS_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_URL=http://localhost
AGENT_PUBLIC_URL=/agent
LOG_LEVEL=info

DAILY_PRODUCT_RESEARCH_MODE=PILOT
DAILY_PRODUCT_RESEARCH_GENERAL_ACCESS_ENABLED=false
DAILY_PRODUCT_RESEARCH_PILOT_ORGANIZATION_IDS=
SUPPLIER_IMAGE_SEARCH_ENRICHMENT_ENABLED=false
SUPPLIER_IMAGE_SEARCH_ENRICHMENT_LIMIT=10
PLATFORM_ORG_ID=
AUTOMATION_SCHEDULER_INTERVAL_MS=30000
PRODUCT_LAUNCH_RECOVERY_INTERVAL_MS=60000
PRODUCT_LAUNCH_RECOVERY_STALE_AFTER_MS=300000
AGENT_AUTONOMY_INTERVAL_SECONDS=300
AGENT_AUTONOMY_MAX_ATTEMPTS=3
