# ============================================================
# 电商产品图智能体 — 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的 API Key
# cp .env.example .env

# --- AI 引擎 API Keys ---
# 必填：至少需要配置一个生图引擎
# 推荐：Gemini（产品一致性最好）
GEMINI_API_KEY=
# 可选：Gemini 生图模型（默认 gemini-2.5-flash-image；高端可用 gemini-3-pro-image）
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MINIMAX_API_KEY=

# 可选：预留引擎（当前为占位，有真实 API 后配置）
MIDJOURNEY_API_KEY=

# --- OpenAI 兼容 LLM（编排器 / 视觉分析）---
OPENAI_API_BASE=https://your-proxy.com/v1
# 聊天/分析 LLM Key（gpt-5 等走 OPENAI_API_KEY_PREMIUM 路由）
OPENAI_API_KEY=sk-...
OPENAI_API_KEY_PREMIUM=sk-...
# 主模型不可用时依次尝试备用模型与备用 Key。
LLM_MODEL_BACKUP=
ORCHESTRATOR_LLM_PROVIDER=openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
# 编排/对话 LLM 超时秒数（默认 45；代理型 API 响应慢时不要设太小，
# 过小会频繁超时回退到正则模板，对话显得"不智能"）
# ORCHESTRATOR_LLM_TIMEOUT=45
# 完全禁用编排 LLM（测试/离线环境用；禁用后走关键词规则理解）
# ORCHESTRATOR_LLM_DISABLED=0
# 可选：精准改图的视觉定位/验收模型（未配置时沿用 IDENTITY_QA_MODEL / LLM_MODEL）
# VISUAL_LOCATE_MODEL=gpt-5.5
# 记忆 v2：经验入库前的 LLM 审核（设 0 走规则审核，离线可用）
# MEMORY_REVIEW_LLM=1
# 可选：MAX 思考模式专用强模型（未配置时沿用 LLM_MODEL）
# LLM_MODEL_MAX=gpt-5.5

# 生图引擎（与聊天 Key 分离：生图不走 premium 路由）
# IMAGE_ENGINE=gemini|dalle|minimax
IMAGE_ENGINE=dalle
OPENAI_IMAGE_MODEL=gpt-image-2
# 可选：单独的生图 Key；未设置时使用 OPENAI_API_KEY
# OPENAI_IMAGE_API_KEY=sk-...
IMAGE_API_KEY_BACKUP=
IMAGE_MODEL_BACKUP=

# 可选：本地 Stable Diffusion / FLUX
SD_API_URL=http://localhost:7860

# --- MiniMax 高级配置 ---
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VL_MODEL=MiniMax-VL

# --- 高清导出（1K/2K/3K/4K/8K/18K 分档）---
# 可选：AI 超分（Real-ESRGAN）。下载 realesrgan-ncnn-vulkan 可执行文件后填路径即启用；
# 未配置时自动回退「分级 Lanczos + 锐化」，功能不受影响。
# 下载: https://github.com/xinntao/Real-ESRGAN/releases
# REALESRGAN_EXE=C:\tools\realesrgan\realesrgan-ncnn-vulkan.exe
# 可选：超分模型名（-n 参数，默认由工具决定，常用 realesrgan-x4plus）
# REALESRGAN_MODEL=realesrgan-x4plus
# 可选：导出长边上限（默认 18000）
# HD_EXPORT_MAX_EDGE=18000

# --- Web UI ---
FLASK_PORT=8080
FLASK_DEBUG=0
# 可选：访问口令（设置后整站需登录才能访问，适合公网/Docker 部署）
# WEB_ACCESS_PASSWORD=
# 建议同时固定 SECRET_KEY，避免重启后登录态失效
# FLASK_SECRET_KEY=

# --- 日志级别 ---
LOG_LEVEL=INFO

# --- 上网研究（竞品搜索 / 参考图抓取）---
# 搜索 API（优先级：Serper > Tavily > Bing，至少配置一个）
SERPER_API_KEY=
TAVILY_API_KEY=
BING_SEARCH_API_KEY=

# --- 上架风险放行门禁（默认 fail closed）---
# 逗号分隔、由部署方审核过的外部风控 provider 名称；留空时所有上架风险检查均阻断。
RISK_CLEARANCE_AUTHORIZED_PROVIDERS=
# 内部适配器用于签署已核验外部结果的 HMAC 密钥（至少 32 字节）。
# 不要交给 MCP/HTTP 调用方，不要把真实值提交到仓库；留空时任何凭证都不能放行。
RISK_CLEARANCE_ATTESTATION_SECRET=
# 服务端允许凭证距 fetchedAt 的最大秒数；同时仍强制 expiresAt，默认 86400（24 小时）。
RISK_CLEARANCE_MAX_AGE_SECONDS=86400

# --- Documented 1688 image search + future exact quote enrichment ---
# Keep the real token only in agent/.env. Never put it in this example or compose files.
SUPPLIER_QUOTE_ENABLED=0
SUPPLIER_QUOTE_PROVIDER=1688-image-search-v1
SUPPLIER_QUOTE_API_BASE_URL=
# Fixed by API-imageSearch1688-search.md (2026-07-16).
SUPPLIER_QUOTE_IMAGE_SEARCH_PATH=/api/imageSearch1688/search
# Optional for image-only mode. Leave blank until a separate exact-quote contract exists.
SUPPLIER_QUOTE_EXACT_QUOTE_PATH=
SUPPLIER_QUOTE_API_KEY=
SUPPLIER_QUOTE_DESTINATION_COUNTRY=RU
SUPPLIER_QUOTE_QUANTITY=100
SUPPLIER_QUOTE_TIMEOUT_SECONDS=20
SUPPLIER_QUOTE_MAX_AGE_SECONDS=3600
SUPPLIER_QUOTE_MAX_IMAGE_RESULTS=10
# Keyword fallback is recall-only and can never unlock verified product cost.
SUPPLIER_QUOTE_KEYWORD_FALLBACK=1

# JS 渲染（淘宝/Amazon 等需要登录的页面）
PLAYWRIGHT_ENABLED=0
# 可选：playwright install chromium

# Cookie 池（JSON 文件，按域名存放登录 Cookie）
# 示例结构见 agent/templates/cookie_jar.example.json
COOKIE_JAR_PATH=

# --- 平台对接 API（ShopMate 平台后端调用 /api/v1/agent/*）---
# 必填才启用：平台后端用同一个 Key 通过 X-Api-Key 请求头访问
# AGENT_API_KEY=
# 可选：后台生成任务的最大并发数（默认 2）
AGENT_MAX_CONCURRENCY=2
# Global product discovery stops starting external calls after this budget.
GLOBAL_DISCOVERY_BUDGET_SECONDS=720
# Optional writable runtime data directory for jobs, sessions, uploads, and outputs.
# AGENT_RUNTIME_DIR=C:\\ShopMateAgentRuntime
# Autonomous read-only polling. Disabled by default until a real organization is set.
# PLATFORM_API_BASE=http://127.0.0.1:3000/api/v1
# PLATFORM_ORG_ID=replace-with-real-organization-id
# AGENT_AUTONOMY_RUNTIME_ENABLED=0
# AGENT_AUTONOMY_INTERVAL_SECONDS=300
# AGENT_AUTONOMY_MAX_ATTEMPTS=3
# 可选：任务进度实时回调平台（两项都配置才启用；密钥与平台 AGENT_WEBHOOK_SECRET 一致）
# PLATFORM_CALLBACK_URL=http://localhost:3000
# AGENT_WEBHOOK_SECRET=please-change-me-min-16-chars
# 可选：高成本接口（生图/导出/commerce）每 IP 每分钟限流（默认 60）
# EXPENSIVE_RATE_LIMIT=60
# 可选：聊天消息中允许导入的本机图片目录白名单（分号分隔，默认用户主目录）
# LOCAL_IMAGE_IMPORT_ROOTS=C:\Users\me\Pictures;D:\products

# --- 外部产品一致性检测 Agent（非侵入式增强 QA）---
# 配置后自动启用外部 Agent 做叠加一致性检查（不替换现有 QA）。
# 请先确保已安装 requests 库: pip install requests
CONSISTENCY_AGENT_URL=
# 可选：外部 Agent 认证密钥
# CONSISTENCY_AGENT_API_KEY=
# 可选：请求超时秒数（默认 30）
# CONSISTENCY_AGENT_TIMEOUT=30
